# Korra Backend — Environment Variables
#
# Every variable below is read somewhere in core/settings.py — this file's shape (names, order,
# grouping) is meant to mirror that file's own sections exactly, so the two never drift apart.
# Copy to .env and fill in real values; .env is gitignored and never committed.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database — Supabase Postgres (env.db()-style URL)
# ---------------------------------------------------------------------------
# From Supabase Dashboard -> Settings -> Database -> Connection string -> URI (Session pooler,
# port 6543). Do NOT append "?pgbouncer=true" -- that query param isn't a valid psycopg2/libpq
# option and breaks the connection outright (found live -- see korra-project/SUCCESS_FLOW_STEPS.md).
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
NEXTJS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — Auth / API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy shared secret (HS256) -- kept only because settings.py still reads it; not what verifies
# session JWTs anymore (see SUPABASE_JWT_PUBLIC_KEY below). Dashboard -> Settings -> API -> JWT
# Settings -> "Legacy JWT secret".
SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# ES256 public key SupabaseJWTAuthentication actually verifies session JWTs with (see
# accounts/authentication.py) -- required, auth fails closed without it. Dashboard -> Settings ->
# API -> JWT Settings -> "Key Details" (paste either the PEM or the JWK JSON shown there -- both
# are accepted, no manual conversion needed).
# IMPORTANT if pasting the JWK JSON: it must be on ONE line. The dashboard shows it pretty-printed
# across multiple lines -- pasted as-is like that, django-environ silently truncates the value to
# just "{" (everything after the first line is dropped as an "Invalid line"), which then fails to
# parse as JSON and auth breaks closed. Compact it to one line first (any JSON minifier, or
# `python -c "import json,sys;print(json.dumps(json.load(sys.stdin)))"` piped the pretty JSON in).
SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR-KEY-HERE\n-----END PUBLIC KEY-----"

# New-style publishable key from the dashboard's API settings page. Not currently read by any
# Django code (no client uses it yet) -- kept here only so this file matches what's actually in a
# freshly-copied Supabase project config. Safe to leave blank if you don't have one yet.
SUPABASE_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# UiPath webhook
# ---------------------------------------------------------------------------
UIPATH_WEBHOOK_SECRET=your-uipath-webhook-secret

# ---------------------------------------------------------------------------
# Linear
# ---------------------------------------------------------------------------
LINEAR_API_KEY=your-linear-api-key

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
